# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/archflow?schema=public"

# Authentication (NextAuth.js v5)
AUTH_SECRET="your-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Real-time WebSockets (Pusher)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="sa1"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="sa1"

# Email Delivery (Resend - Optional)
RESEND_API_KEY=""
