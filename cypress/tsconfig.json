{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext", "dom"],
    "types": ["cypress", "node"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts"
  ]
}
