{
  "name": "erp-archflow-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ArchFlow ERP - Sistema Integrado de Gestão para Escritórios de Arquitetura",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:front": "npm run dev --prefix frontend",
    "dev:back": "mvn -f backend/pom.xml spring-boot:run",
    "build:front": "npm run build --prefix frontend",
    "build:back": "mvn -f backend/pom.xml clean package -DskipTests",
    "test:front": "npm run test --prefix frontend",
    "test:back": "mvn -f backend/pom.xml test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "archflow",
    "erp",
    "architecture",
    "spring-boot",
    "react",
    "vite"
  ],
  "author": "ArchFlow Team",
  "license": "UNLICENSED"
}
